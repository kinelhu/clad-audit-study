# Copy to .env and fill in. .env is gitignored — never commit real values.

# Discovery / metadata (free)
NCBI_API_KEY=                       # PubMed E-utilities (raises rate limit)
UNPAYWALL_EMAIL=                    # polite-pool email for Unpaywall / Crossref / OpenAlex

# Full-text acquisition
ISTEX_ACCESS_TOKEN=                 # ISTEX federated JWT (api.istex.fr/token/)
ELSEVIER_API_KEY=                   # dev.elsevier.com
ELSEVIER_INSTTOKEN=                 # X-ELS-Insttoken (request via library / Elsevier support)
WILEY_TDM_TOKEN=                    # Wiley Online Library TDM client token (ORCID)
SPRINGER_META_API_KEY=             # dev.springernature.com (metadata)
SPRINGER_OPEN_ACCESS_API_KEY=      # dev.springernature.com (OA full text)

# Extraction LLM
OPENAI_API_KEY=                    # gpt-5.6-luna via Batch/Responses API
